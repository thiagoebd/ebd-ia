# Conferir contra o .env.example da tag da imagem — nomes mudam entre versoes.

SERVER_TYPE=http
SERVER_PORT=8080
SERVER_URL=http://127.0.0.1:8081

# chave de administracao da API (mesmo valor em EVO_APIKEY no gateway/.env)
AUTHENTICATION_API_KEY=TROCAR_POR_SEGREDO_LONGO
AUTHENTICATION_EXPOSE_IN_FETCH_INSTANCES=true

EVO_PG_PASSWORD=TROCAR_POR_SENHA
DATABASE_ENABLED=true
DATABASE_PROVIDER=postgresql
DATABASE_CONNECTION_URI=postgresql://evolution:TROCAR_POR_SENHA@evolution-postgres:5432/evolution?schema=public
DATABASE_CONNECTION_CLIENT_NAME=ebdia_evolution

# PRIVACIDADE: nao guardar mensagens, contatos, conversas nem historico
DATABASE_SAVE_DATA_INSTANCE=true
DATABASE_SAVE_DATA_NEW_MESSAGE=false
DATABASE_SAVE_MESSAGE_UPDATE=false
DATABASE_SAVE_DATA_CONTACTS=false
DATABASE_SAVE_DATA_CHATS=false
DATABASE_SAVE_DATA_LABELS=false
DATABASE_SAVE_DATA_HISTORIC=false

CACHE_REDIS_ENABLED=true
CACHE_REDIS_URI=redis://evolution-redis:6379/6
CACHE_REDIS_PREFIX_KEY=evolution
CACHE_REDIS_SAVE_INSTANCES=false
CACHE_LOCAL_ENABLED=false

# webhook global desligado: o webhook e por instancia (scripts/wa_setup.sh)
WEBHOOK_GLOBAL_ENABLED=false

CONFIG_SESSION_PHONE_CLIENT=EBD.ia
CONFIG_SESSION_PHONE_NAME=Chrome
QRCODE_LIMIT=30
DEL_INSTANCE=false
LOG_LEVEL=ERROR,WARN
LOG_BAILEYS=error
